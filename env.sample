# انسخ الملف ده وسميه .env.local وحط فيه القيم الحقيقية (الملف ده متجاهل من git عمدًا)

# هتلاقيهم لما تعمل Vercel Postgres (Neon) في مشروعك على Vercel
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# نتيجة تشغيل: openssl rand -base64 32
NEXTAUTH_SECRET="ضع-هنا-قيمة-عشوائية-طويلة"

# رابط موقعك بعد الرفع على Vercel (لو شغال محلي سيبه كده)
NEXTAUTH_URL="http://localhost:3000"

# كود سري تختاروه انت وزوجتك بس عشان تسجلوا حسابين
REGISTRATION_CODE="اختار-كود-سري"

# أقصى عدد حسابات مسموح بيها (اختياري، افتراضي 2)
MAX_USERS=2
